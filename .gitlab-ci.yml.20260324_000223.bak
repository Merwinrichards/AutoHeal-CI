stages:
  - build

build:
  stage: build
  image: python:3.9-slim # Primary image for Python-related tasks
  services:
    - docker:20.10.16-dind # Adds a Docker-in-Docker service to the job
  variables:
    DOCKER_HOST: tcp://docker:2375 # Points the Docker client to the dind service
    DOCKER_TLS_CERTDIR: "" # Disables TLS for Docker communication, common with dind in CI
    # DOCKER_DRIVER: overlay2 # Optional: Specify storage driver for better performance

  script:
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 000 /protected_area
    - cat /protected_area/config.json
    - docker info # This command will now successfully execute
    # Add any further Docker commands (e.g., docker build, docker push) here
