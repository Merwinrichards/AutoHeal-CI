stages:
  - build

build:
  stage: build
  image: python:3.9-slim # Keep the primary image for Python tasks
  services: # Add the Docker-in-Docker service
    - docker:dind
  variables: # Configure the Docker client to connect to the DinD service
    DOCKER_HOST: tcp://docker:2375 # Connect to the DinD service
    DOCKER_TLS_CERTDIR: "" # Disable TLS verification for DinD service if not explicitly required, common for internal CI
  script:
    # Install the Docker client into the main job container
    - apt-get update -y
    - apt-get install -y docker.io # Installs the Docker CLI
    
    # Original script commands
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 000 /protected_area
    - cat /protected_area/config.json # This will likely fail with "Permission denied" due to chmod 000 on the directory
    - docker info # This command should now execute successfully
