stages:
  - build

build:
  stage: build
  image: python:3.9-slim # The original Python image
  services:
    - docker:dind # Add the Docker-in-Docker service to provide a Docker daemon
  variables:
    DOCKER_HOST: tcp://docker:2375 # Point the Docker client to the dind service
    DOCKER_TLS_CERTDIR: "" # Disable TLS verification for simplicity in CI/CD
  script:
    # Install the Docker client within the python:3.9-slim container
    - apt-get update -y && apt-get install -y docker.io
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 000 /protected_area
    - cat /protected_area/config.json
    - docker info # This command should now execute successfully
