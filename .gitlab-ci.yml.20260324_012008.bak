stages:
  - build

build:
  stage: build
  image: docker:latest # Changed to an image that includes the Docker client
  script:
    - apt-get update -yqq # Update package lists in the new image
    - apt-get install -yq python3-pip # Install pip as it's not present by default in docker:latest
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 000 /protected_area
    - cat /protected_area/config.json
    - docker info # This command will now be found and executed
