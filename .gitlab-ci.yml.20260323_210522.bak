image: python:3.9-slim-buster

stages:
  - build
  - test
  - deploy

build_job:
  stage: build
  script:
    - echo "Python environment setup complete."
    - python --version
    - pip install -r requirements.txt
    - python your_build_script.py

test_job:
  stage: test
  script:
    - python -m pytest
