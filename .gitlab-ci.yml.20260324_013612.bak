stages:
  - build

build:
  stage: build
  image: python:3.9-slim
  services:
    - docker:dind
  variables:
    DOCKER_HOST: tcp://docker:2375
    DOCKER_TLS_CERTDIR: "/certs"
  script:
    - apt-get update -yqq
    - apt-get install -yqq docker.io
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 000 /protected_area
    - cat /protected_area/config.json
    - docker info
