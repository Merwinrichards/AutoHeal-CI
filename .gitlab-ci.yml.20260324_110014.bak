stages:
  - build

build:
  stage: build
  image: python:3.9-slim # The main job image for Python-specific tasks
  services:
    - docker:dind # The Docker-in-Docker service to provide a Docker daemon
  variables:
    DOCKER_HOST: tcp://docker:2375 # Connect to the dind service (named 'docker')
    DOCKER_TLS_CERTDIR: "" # Disable TLS for plain TCP connection to the dind service
  script:
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    # The original script contained:
    # - chmod 000 /protected_area
    # - cat /protected_area/config.json
    # These lines are removed from the corrected script.
    # `chmod 000` on a directory makes it completely inaccessible,
    # causing any subsequent attempt to `cat` a file within it to fail with "Permission denied".
    # For a functional pipeline, this logically conflicting sequence is omitted.
    - docker info # This command will now execute successfully by connecting to the dind service
