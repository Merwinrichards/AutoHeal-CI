stages:
  - build

build:
  stage: build
  image: docker/compose:latest # Use an image that includes the Docker client, Python, and pip
  services:
    - docker:dind # Starts a Docker-in-Docker service, providing a Docker daemon for the job
  variables:
    DOCKER_HOST: tcp://docker:2375 # Instructs the Docker client to connect to the dind service
    DOCKER_TLS_CERTDIR: "" # Disables TLS for Docker-in-Docker communication, common for CI
  script:
    # pip install commands will work as docker/compose:latest includes Python and pip
    - pip install psycopg2-binary
    - mkdir /protected_area
    - touch /protected_area/config.json
    - chmod 644 /protected_area/config.json
    - cat /protected_area/config.json
    - docker info # This command will now execute successfully using the dind service
