image: python:3.9 # Use a Docker image that comes with Python pre-installed.
                   # You can choose a specific version like python:3.9, python:3.10, or python:latest.

stages:
  - build

build:
  stage: build
  script:
    - python --version # Verify Python is now available
    - echo "Python is now available for your scripts!"
    # Add your original Python commands here, e.g.:
    # - pip install -r requirements.txt
    # - python your_script.py
